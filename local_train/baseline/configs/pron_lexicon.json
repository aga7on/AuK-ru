{
  "comment": "Правила респеллера (после RuAccent). Эмпирика (GigaAM + честный слух + авто-судья Gemini): раз-в+итие; объ-явление (9/10); п+ольз-ования (8/10); встр->фстр (9/10); произнош->пра-из-наш (9/10); смо-треть (лучший, слух); эн+эргии; со-хран+ения.",
  "patterns": [
    { "find": "(?i)(раз)(в)(?=\\+?и)", "repl": "\\1-\\2" },
    { "find": "(?i)(объ)(явл)(?=\\+?[её])", "repl": "\\1-\\2" },
    { "find": "(?i)(п\\+ольз)(?=ован)", "repl": "\\1-" },
    { "find": "Встр(?=\\+?еч)", "repl": "Фстр" },
    { "find": "(?i)встр(?=\\+?еч)", "repl": "фстр" },
    { "find": "Произнош(?=\\+?[её])", "repl": "Пра-из-наш" },
    { "find": "(?i)произнош(?=\\+?[её])", "repl": "пра-из-наш" },
    { "find": "(?i)смотр\\+(?=еть)", "repl": "с-мо-тр+" },
    { "find": "(?i)(со)(хран)(?=\\+?[её])", "repl": "\\1-\\2" },
    { "find": "(?i)(эн)(\\+)(?=е(?!ргет))", "repl": "\\1\\2э" }
  ]
}
